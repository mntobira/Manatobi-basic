    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "^3.78.0"
  },
  "engines": {
    "node": ">=22"
  }
